# Which data source the UI uses. Never mixed: exactly one is active per build.
#   mock    -> deterministic synthetic development data (default)
#   backend -> the real AegisAI backend adapters (NOT implemented yet; the UI
#              will show an explicit "backend unavailable" state, never fall
#              back to mock data)
VITE_AEGIS_SOURCE=mock

# Base URL of the AegisAI backend. Only read when VITE_AEGIS_SOURCE=backend.
# VITE_AEGIS_BACKEND_URL=
